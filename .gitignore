# =============================================================================
# Rakit — Git ignore rules
# =============================================================================

# -----------------------------------------------------------------------------
# Maintainer-only working documents
# -----------------------------------------------------------------------------
# Public documentation such as docs/roadmap.md and docs/design/ remains tracked.
# Implementation plans, private notes, and unfinished drafts stay local.
docs/plans/
docs/drafts/
docs/private/
docs/notes/
docs/scratch/

# Locally generated design/plan bundles
rakit-design/
rakit-implementation/
rakit-design-ready.zip
rakit-design-and-implementation-plans.zip

# -----------------------------------------------------------------------------
# Python bytecode and interpreter caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# -----------------------------------------------------------------------------
# Python environments
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# -----------------------------------------------------------------------------
# Python packaging and build output
# -----------------------------------------------------------------------------
build/
dist/
wheels/
*.egg-info/
.eggs/
pip-wheel-metadata/
MANIFEST

# Keep the committed uv lockfile.
!uv.lock

# -----------------------------------------------------------------------------
# Test, lint, typing, and coverage caches
# -----------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.pyre/
.ty/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
coverage.json
htmlcov/
junit.xml

# -----------------------------------------------------------------------------
# Documentation build output
# -----------------------------------------------------------------------------
site/
.mkdocs_cache/
.doctrees/
docs/_build/

# -----------------------------------------------------------------------------
# Browser and end-to-end test output
# -----------------------------------------------------------------------------
playwright-report/
test-results/
blob-report/
.cache/ms-playwright/

# -----------------------------------------------------------------------------
# Jupyter
# -----------------------------------------------------------------------------
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Environment files and local configuration
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
!.env.*.example

*.local
*.local.toml
*.local.yaml
*.local.yml
*.local.json

# -----------------------------------------------------------------------------
# Secrets, credentials, and private keys
# -----------------------------------------------------------------------------
secrets/
credentials/
credentials*.json
service-account*.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Keep safe examples and templates.
!secrets/.gitkeep
!secrets/**/*.example
!credentials/**/*.example

# -----------------------------------------------------------------------------
# Local databases, runtime data, and uploaded files
# -----------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

data/
var/
.var/
runtime/
uploads/
media/
storage/
local-storage/

# Keep intentionally committed empty directories or fixtures.
!data/.gitkeep
!var/.gitkeep
!uploads/.gitkeep
!media/.gitkeep
!storage/.gitkeep
!tests/fixtures/**/*.db
!tests/fixtures/**/*.sqlite
!tests/fixtures/**/*.sqlite3

# -----------------------------------------------------------------------------
# Logs, process state, and temporary files
# -----------------------------------------------------------------------------
*.log
logs/
*.pid
*.pid.lock
*.seed
*.tmp
*.temp
tmp/
temp/
.cache/

# -----------------------------------------------------------------------------
# Frontend and asset toolchain
# -----------------------------------------------------------------------------
node_modules/
.npm/
.pnpm-store/
.yarn/
.yarn-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# IDEs and editors
# -----------------------------------------------------------------------------
.idea/

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

*.code-workspace
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*.swn
*~

# Emacs
\#*\#
.\#*

# -----------------------------------------------------------------------------
# AI coding tools — local state only
# -----------------------------------------------------------------------------
.codex/
.opencode/
.aider*
.claude/settings.local.json
.cursor/*.local.*
.windsurf/*.local.*

AGENTS.local.md
CLAUDE.local.md

# Project-wide AGENTS.md, CLAUDE.md, and committed AI rules remain trackable.

# -----------------------------------------------------------------------------
# Operating-system files
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Archives generated locally
# -----------------------------------------------------------------------------
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# Allow intentionally committed archives under test fixtures.
!tests/fixtures/**/*.zip
!tests/fixtures/**/*.tar
!tests/fixtures/**/*.tar.gz
